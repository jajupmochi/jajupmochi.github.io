  "proj": {
    "liulian": {
      "title": "LIULIAN：面向交互式自适应网络的液态智能与统一逻辑",
      "date": "2026 - 至今",
      "desc": "<li><strong>时空数据平台</strong>：面向科学与工程领域的数据采集、处理、分析与可视化。</li><li><strong>多模态科学图数据基准</strong>。</li><li><strong>LLM 驱动的数据交互界面与 BI 智能体系统</strong>。</li><li>整合<strong>博士与博士后阶段的图机器学习研究</strong>（核方法、GED、GNN、预映射）。</li><li>正在准备 <strong>Innosuisse 创新项目</strong>资助申请。</li>"
    },
    "river": {
      "title": "用于河流温度预测的时空图卷积网络",
      "date": "2025 - 至今",
      "desc": "<li>由 <strong>SNSF 资助</strong>，研究基于图的瑞士河流水温预测。</li><li>开发<strong>时空 Transformer 与 LLM 架构</strong>，融合实体嵌入与图结构。</li><li>论文被 <strong>ICPR 2026</strong> 接收。</li><li class=\"project-partners\">🤝 <strong>合作方：</strong>伯尔尼大学模式识别组 (UniBE) × 伯尔尼应用科学大学 (BFH)。</li>"
    },
    "nbanker": {
      "title": "N-Banker：全球首个新型银行研究中心",
      "date": "2024 - 至今",
      "desc": "<li><strong>主导 Neobank 研究中心平台的 AI 战略与 LLM 智能体开发</strong>。</li><li>为业务伙伴提供<strong>复杂信息检索、分析与战略咨询的自动化</strong>。</li><li>基于<strong>机器学习 + LLM 技术栈</strong>构建（RAG、智能体、金融科技流水线）。</li><li class=\"project-partners\">🤝 <strong>合作方：</strong>数字金融服务研究中心 × 香港理工大学。</li>"
    },
    "graphink": {
      "title": "结合图像与图神经网络的手写体识别",
      "date": "2024 - 至今",
      "desc": "<li>由 <strong>SNSF 资助</strong>，研究历史手写文档的分析方法。</li><li>结合<strong>基于图像的语义信息与基于图的拓扑结构进行深度学习</strong>。</li><li><strong>论文修订中</strong>。</li><li class=\"project-partners\">🤝 <strong>合作方：</strong>iCoSys 研究所（HEIA，HES-SO Fribourg）× 多特蒙德工业大学。</li>"
    },
    "gklearn": {
      "title": "graphkit-learn",
      "date": "2020 - 至今",
      "desc": "<li>用于图核、图编辑距离与图预映射问题的 <strong>Python 库</strong>。</li><li><strong>全球范围</strong>用于图分类与回归。</li><li>APi（ANR）基金资助下的 <strong>开源成果</strong>。</li>",
      "per_month": "/月"
    },
    "planalyser": {
      "title": "PLANALYSER：基于 AI 的暖通空调方案自动审查与优化",
      "date": "2024 - 2025",
      "desc": "<li>由 <strong>Innosuisse 资助</strong>，对工程图纸进行 AI 驱动的暖通空调方案审查与优化。</li><li>贡献：<strong>数据预处理、模型开发</strong>（符号 / 连接 / 拓扑提取）、流水线设计。</li><li class=\"project-partners\">🤝 <strong>合作方：</strong>iCoSys 研究所（HEIA，HES-SO Fribourg）× WATTELSE AG。</li>"
    },
    "gmatch": {
      "title": "新型先进图匹配算法",
